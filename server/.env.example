PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

DATABASE_URL="postgresql://DATABASE_USER:DATABASE_PASSWORD@POOLED_DATABASE_HOST/DATABASE_NAME?sslmode=require"
DIRECT_URL="postgresql://DATABASE_USER:DATABASE_PASSWORD@DIRECT_DATABASE_HOST/DATABASE_NAME?sslmode=require"

SEED_ADMIN_PASSWORD="CHANGE_ME"
SEED_LECTURER_PASSWORD="CHANGE_ME"
SEED_STUDENT_PASSWORD="CHANGE_ME"

JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-64-characters-long-before-running"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME="examflow_refresh_token"